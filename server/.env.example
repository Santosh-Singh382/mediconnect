# Server runtime
NODE_ENV=development
PORT=5000

# MongoDB connection string (database: mediconnect)
MONGODB_URI=mongodb://localhost:27017/mediconnect

# Comma-separated list of allowed browser origins for CORS and Socket.IO
CLIENT_URL=http://localhost:5173

# JWT signing secret. Required. Set a long random value for every environment.
JWT_SECRET=replace-with-a-long-random-development-secret