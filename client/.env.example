# Base URL for the Telemedicine API.
# Leave empty to use the Vite dev proxy (recommended for local development).
VITE_API_BASE_URL=

# Optional Socket.IO server URL. Leave empty to use the same origin
# (the Vite dev proxy forwards /socket.io to the backend).
VITE_SOCKET_URL=

# Optional ICE servers for WebRTC video consultations, as a JSON array.
# When unset, a public STUN server is used for development/demo only and does
# NOT guarantee connectivity on every network. Add a TURN server for production.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
